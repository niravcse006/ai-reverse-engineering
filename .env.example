# Copy this file to `.env` and replace placeholders. Never commit real secrets.

# Logging
REA_LOG_LEVEL=info

# Deep analysis provider: auto, hopper, ghidra, ida, or kuna
REA_ANALYSIS_PROVIDER=auto

# Optional AI interpretation. Leave unset to keep analysis offline.
REA_AI_PROVIDER=none
REA_AI_MODEL=
REA_AI_ENDPOINT=
REA_AI_API_KEY=
REA_AI_TIMEOUT_MS=30000
REA_AI_RETRIES=1
REA_AI_TOKEN_LIMIT=4096
REA_AI_SPENDING_LIMIT_USD=

# Native providers. Use absolute paths only.
HOPPER_LAUNCHER_PATH=
GHIDRA_INSTALL_DIR=
JAVA_HOME=
REA_IDA_MCP_CONFIG=
REA_KUNA_COMMAND=
REA_JADX_COMMAND=
REA_APKTOOL_COMMAND=
REA_RIZIN_COMMAND=
REA_OBJDUMP_COMMAND=
REA_GDB_COMMAND=

# MCP transport budgets
REA_MCP_MAX_RESPONSE_BYTES=
REA_MCP_MAX_INPUT_ELEMENTS=
REA_MCP_INPUT_SCHEMA_PROFILE=
REA_MCP_OUTPUT_SCHEMA_PROFILE=
REA_MCP_TOOL_FAMILIES=

# Optional JEB MCP endpoint
REA_JEB_MCP_URL=
REA_JEB_MCP_TIMEOUT_MS=
